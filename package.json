{
  "name": "phasmo-ghost-finder",
  "version": "1.0.0",
  "description": "In-game overlay for Phasmophobia: a ghost finder you open with one key, plus OBS replay clips on a hotkey.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "test": "xvfb-run -a -s \"-screen 0 1920x1080x24\" electron test/harness.js --no-sandbox --disable-gpu",
    "build:overlay": "python3 scripts/build_overlay.py"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "obs-websocket-js": "5.0.6"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.phasmo.ghostfinder",
    "productName": "Phasmo Ghost Finder",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PhasmoGhostFinder-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PhasmoGhostFinder-portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thechonkman",
        "repo": "phasmo-ghost-finder",
        "releaseType": "release"
      }
    ]
  }
}
