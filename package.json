{
  "name": "phasmo-ghost-finder",
  "version": "1.0.0",
  "description": "Always-on-top Phasmophobia ghost finder that starts OBS and saves replay clips on a hotkey.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "obs-websocket-js": "5.0.6"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.phasmo.ghostfinder",
    "productName": "Phasmo Ghost Finder",
    "files": ["main.js", "preload.js", "renderer/**", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "PhasmoGhostFinder-portable-${version}.exe" }
  }
}
